rules_version = '2';

// KompSavod – ma'lumotlar bazasi xavfsizlik qoidalari.
// Firebase Console → Firestore Database → Rules bo'limiga to'liq nusxalab qo'ying va "Publish" bosing.
//
// Asosiy tamoyillar:
//  • O'quvchi faqat o'zining ma'lumotini ko'radi, admin hammasini ko'radi.
//  • O'quvchi o'ziga ruxsat yoki admin huquqini bera olmaydi.
//  • Telefon raqami SMS orqali tasdiqlangan raqam bilan bir xil bo'lishi shart.
//  • Foydalanuvchi va kurslarni hech kim o'chira olmaydi (ma'lumot yo'qolmasligi uchun).
//  • Video darslarni faqat admin ruxsat bergan o'quvchi ko'radi.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn() && exists(myDoc()) && get(myDoc()).data.role == 'admin';
    }

    function isApprovedFor(courseId) {
      return signedIn() && exists(myDoc())
        && get(myDoc()).data.status == 'approved'
        && courseId in get(myDoc()).data.courses;
    }

    // ---------- O'quvchilar ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Ro'yxatdan o'tish: faqat o'zi uchun, "kutilmoqda" holatida, tasdiqlangan raqam bilan
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'contactPhone', 'region', 'status', 'role', 'courses', 'createdAt', 'lastLoginAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 60
        && request.resource.data.phone == request.auth.token.phone_number
        && (!('contactPhone' in request.resource.data) || (request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 20))
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'student'
        && request.resource.data.courses == []
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      // O'quvchi faqat oxirgi kirish vaqtini yangilay oladi; qolganini faqat admin o'zgartiradi
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt'])
            && request.resource.data.lastLoginAt == request.time);

      allow delete: if false;
    }

    // ---------- Kurslar ----------
    match /courses/{courseId} {
      // Saytda e'lon qilingan kurslarni hamma ko'radi
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;

      // Darslar (video havolalar): faqat ruxsat berilgan o'quvchi va admin
      match /lessons/{lessonId} {
        allow read: if isAdmin() || isApprovedFor(courseId);
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }

    // ---------- Sharhlar ----------
    match /reviews/{reviewId} {
      // Sharhlarni hamma o'qiy oladi (saytda ko'rsatish uchun)
      allow read: if true;

      // Ro'yxatdan o'tmagan odam ham, ism kiritmasdan (anonim) sharh qoldira oladi
      allow create: if request.resource.data.keys().hasOnly(['text', 'rating', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 600
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;

      // Tahrirlab bo'lmaydi; faqat admin o'chira oladi
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Boshqa hamma narsa yopiq
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
